# ============================================================
# .env - Cấu hình Grok Auto Register
# Copy file này thành .env và điền key của bạn
# ============================================================

# ---- Captcha solver (chọn 1 trong 3, điền key là được) ----
# YesCaptcha: https://yescaptcha.com
YESCAPTCHA_API_KEY=

# CapSolver: https://capsolver.com
CAPSOLVER_API_KEY=

# EzCaptcha: https://ez-captcha.com
EZCAPTCHA_API_KEY=

# ---- Local Captcha Solver (miễn phí, dùng Playwright browser thật) ----
# Bật: LOCAL_CAPTCHA=true  (không cần API key, tự giải bằng Chromium)
# Cần cài: pip install playwright && python -m playwright install chromium
LOCAL_CAPTCHA=false
LOCAL_CAPTCHA_HEADLESS=true
LOCAL_CAPTCHA_TIMEOUT=30
LOCAL_CAPTCHA_RETRIES=3

# ---- Temp email provider ----
# Chọn: yyds | gptmail | moemail | cfmail (mặc định gptmail, có key test miễn phí)
TEMP_EMAIL_PROVIDER=gptmail

# YYDS Mail (cần đăng ký tại vip.215.im)
YYDS_API_KEY=

# GPTMail (có thể dùng key test "gpt-test" miễn phí)
GPTMAIL_API_KEY=gpt-test

# MoeMail (tự deploy)
MOEMAIL_BASE_URL=
MOEMAIL_API_KEY=

# ---- Proxy ----
# HTTP proxy cho Clash/V2Ray/etc (ví dụ: http://127.0.0.1:7890)
CLASH_PROXY=http://127.0.0.1:7890

# ---- Token output directory ----
TOKEN_OUTPUT_DIR=tokens

# ---- SUB2API (tùy chọn) ----
# Điền nếu muốn tự động upload token sau khi đăng ký (dùng --sub2api)
SUB2API_URL=
SUB2API_EMAIL=
SUB2API_PASSWORD=
SUB2API_GROK_GROUP=grok
SUB2API_GROK_PROXY_ID=0
